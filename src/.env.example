OPENAI_API_KEY=
DATABASE_URL=mysql://user:password@localhost:3306/esgtech
DATABASE=esgtech
HOST=localhost
USER_NAME=user
PASSWORD=password
NEXT_PUBLIC_BASE_URL=http://localhost:3000
BETTER_AUTH_SECRET=use-the-same-secret-as-the-ESG-application

# Manager invitations: production defaults to ZeptoMail; development/test default to the Mailtrap Email Sandbox.
# Optional explicit override; leave unset for environment defaults.
# POLICYCRAFT_MAIL_PROVIDER=
POLICYCRAFT_APP_URL=http://localhost:3000
# Local sandbox settings. Mailtrap's sandbox host is enforced in code.
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USERNAME=
MAILTRAP_PASSWORD=
MAILTRAP_EMAIL=invites@policycraft.test
# Production ZeptoMail settings. Local development does not fall back to these credentials.
MAIL_HOST=smtp.zeptomail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_EMAIL=
# MAIL_EMAIL is the verified sender. ADMIN_EMAIL is not used for invitations.

